---
import content from '../../content/page-content.json';
const { site } = content;
const { title = `${site.legalName} | KMSC`, description = site.description, canonical = Astro.url } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="KMSC home"><span>KMSC</span><small>Management System Consultancy</small></a>
      <nav aria-label="Main navigation"><a href="/">Home</a><a href="/about/">About</a><a href="/services/">Services</a><a href="/blog/">Blog</a><a href="/contact/">Contact</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div><strong>{site.legalName}</strong><p>Professional training for Client Companies.</p></div><div><a href={`mailto:${site.email}`}>{site.email}</a><a href="/privacy/">Privacy</a><small>© {new Date().getFullYear()} KMSC</small></div></footer>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--navy:#10253f;--blue:#1d5d87;--sky:#e9f4f8;--orange:#ef8b3a;--ink:#203044;--muted:#5b6b7b;--line:#d4e1e7;font-family:'DM Sans',sans-serif;color:var(--ink);background:#fbfcfc}*{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:var(--blue)}a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:1rem;top:1rem;background:white;padding:.5rem;z-index:5}.site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem max(1.5rem,calc((100% - 1120px)/2));background:white;border-bottom:1px solid var(--line)}.brand{color:var(--navy);text-decoration:none;display:flex;flex-direction:column;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.5rem;line-height:1}.brand small{font:500 .62rem 'DM Sans';letter-spacing:.04em;color:var(--muted);margin-top:.35rem}nav{display:flex;gap:1.25rem;flex-wrap:wrap}nav a{font-weight:500;text-decoration:none}main{max-width:1120px;margin:auto;padding:0 1.5rem}.site-footer{margin-top:6rem;padding:2.5rem max(1.5rem,calc((100% - 1120px)/2));display:flex;justify-content:space-between;gap:2rem;background:var(--navy);color:#fff}.site-footer a{color:#fff;margin-right:1.5rem}.site-footer small,.site-footer p{display:block;color:#c4d3dd;margin:.4rem 0}.hero{padding:7rem 0 5rem;max-width:800px}.eyebrow{color:var(--blue);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.8rem}.hero h1{font:700 clamp(2.5rem,7vw,5.5rem)/1.04 'Space Grotesk',sans-serif;color:var(--navy);margin:1rem 0 1.5rem;letter-spacing:-.04em}.hero p{font-size:1.2rem;max-width:650px;color:var(--muted)}.button{display:inline-block;background:var(--orange);color:var(--navy);font-weight:700;padding:.8rem 1.15rem;margin-top:1rem;text-decoration:none;border-radius:3px}.section{padding:3rem 0}.section h2,.page-heading h1{font:700 clamp(2rem,5vw,3.5rem)/1.1 'Space Grotesk',sans-serif;color:var(--navy)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{padding:1.5rem;background:var(--sky);border-top:4px solid var(--orange)}.card h3{font-family:'Space Grotesk',sans-serif;color:var(--navy);line-height:1.2}.page-heading{padding:5rem 0 2rem}.prose{max-width:720px}.prose h2{color:var(--navy)}label{display:block;font-weight:700;margin-top:1rem}input,textarea,select{display:block;width:100%;max-width:650px;padding:.75rem;border:1px solid #8aa3b2;border-radius:3px;font:inherit;margin-top:.35rem}textarea{min-height:150px}.check{display:flex;gap:.5rem;align-items:start;font-weight:400}.check input{width:auto;margin-top:.4rem}.empty{padding:2rem;background:var(--sky);border-left:4px solid var(--orange)}@media(max-width:700px){.site-header{align-items:flex-start;flex-direction:column}.hero{padding:4rem 0}.cards{grid-template-columns:1fr}.site-footer{flex-direction:column;margin-top:4rem}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}
</style>
