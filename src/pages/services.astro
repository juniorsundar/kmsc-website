---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../../content/page-content.json';
import { trainingServices } from '../data/training-services';

const { servicesPage, site } = content;
---
<BaseLayout title={`${servicesPage.heading} | ${site.legalName}`}>
  <section class="page-heading">
    <p class="eyebrow">What we offer</p>
    <h1>{servicesPage.heading}</h1>
  </section>
  <section class="section" aria-label="Training Services overview">
    <p>{servicesPage.intro}</p>
    <div class="cards">
      {trainingServices.map(service => (
        <article class="card">
          <h2>{service.name}</h2>
          <p><strong>{service.summary}</strong></p>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
