---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../../content/page-content.json';
const { site } = content;
---
<BaseLayout title={`Contact | ${site.legalName}`}><section class="page-heading"><p class="eyebrow">Start a conversation</p><h1>Discuss your training needs.</h1></section><section class="prose section"><p>Share a little context and KMSC will be able to understand your enquiry.</p><form action="https://formspree.io/f/placeholder" method="POST"><label for="name">Name<input id="name" name="name" required autocomplete="name" /></label><label for="email">Work email<input id="email" name="email" type="email" required autocomplete="email" /></label><label for="company">Company<input id="company" name="company" required autocomplete="organization" /></label><label for="interest">Training interest<input id="interest" name="training-interest" required /></label><label for="message">Message<textarea id="message" name="message" required></textarea></label><label class="check"><input type="checkbox" name="privacy-consent" required /> I consent to KMSC processing this information to respond to my Training Enquiry.</label><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><button class="button" type="submit">Send Training Enquiry</button></form><p>Or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p></section></BaseLayout>
