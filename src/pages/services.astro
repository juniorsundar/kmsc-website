---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../../content/page-content.json';
const { services, site } = content;
---
<BaseLayout title={`Training Services | ${site.legalName}`}><section class="page-heading"><p class="eyebrow">What we offer</p><h1>Training Services</h1></section><section class="section"><div class="cards">{services.map(service => <article class="card"><h2>{service.name}</h2><p>{service.description}</p></article>)}</div></section></BaseLayout>
