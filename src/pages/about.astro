---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../../content/page-content.json';
const { site, about } = content;
---
<BaseLayout title={`About | ${site.legalName}`}>
  <section class="page-heading">
    <p class="eyebrow">About KMSC</p>
    <h1>{about.heading}</h1>
  </section>
  <section class="prose section">
    <p>{about.intro}</p>
    <h2>{site.author.name}</h2>
    <p><strong>{site.author.role}</strong></p>
    <p>{about.founderBio}</p>
    <p><a class="button" href="/contact/">{site.cta}</a></p>
  </section>
</BaseLayout>
