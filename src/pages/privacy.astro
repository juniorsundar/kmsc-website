---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../../content/page-content.json';
const { site } = content;
---
<BaseLayout title={`Privacy | ${site.legalName}`}>
  <section class="page-heading"><p class="eyebrow">Privacy</p><h1>Your enquiry, handled clearly.</h1></section>
  <section class="prose section">
    <h2>Training Enquiries</h2>
    <p>Information submitted through the Training Enquiry form is collected so KMSC can understand and respond to your request. Formspree processes these form submissions on KMSC’s behalf.</p>
    <p>For privacy questions, email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <h2>No tracking</h2>
    <p>The initial website does not use analytics, advertising pixels, behavioral tracking, or nonessential cookies.</p>
  </section>
</BaseLayout>
