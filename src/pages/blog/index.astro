---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../../content/page-content.json';
import { blogPosts, formatBlogDate } from '../../data/blog-posts';

const { site } = content;
---
<BaseLayout title={`Insights | ${site.legalName}`}>
  <section class="page-heading">
    <p class="eyebrow">KMSC Blog</p>
    <h1>Insights</h1>
  </section>
  <section class="section" aria-label="Published Blog Posts">
    {blogPosts.length === 0 ? (
      <p class="empty">Insights coming soon. Published Blog Posts will appear here.</p>
    ) : (
      <div class="cards">
        {blogPosts.map(post => (
          <article class="card">
            {post.cover && <img src={post.cover} alt={post.coverAlt} />}
            <p><time datetime={post.date}>{formatBlogDate(post.date)}</time></p>
            <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.summary}</p>
            {post.tags.length > 0 && <p>Tags: {post.tags.join(', ')}</p>}
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
