---
import content from '../../content/page-content.json';
import { indexingEnabled } from '../config/release';
import brandLogo from '../assets/brand/kmsc-card-back.png';
const { site } = content;
const {
  title = `${site.legalName} | KMSC`,
  description = site.description,
  type = 'website',
  image = site.socialPreview,
  publishedTime
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;
const effectiveNoindex = !indexingEnabled;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {effectiveNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="KMSC home"><img src={brandLogo.src} width={brandLogo.width} height={brandLogo.height} alt="Kautilya Management System Consultancy Pvt. Ltd. logo" /></a>
      <nav aria-label="Main navigation"><a href="/">Home</a><a href="/about/">About</a><a href="/services/">Services</a><a href="/blog/">Blog</a><a href="/contact/">Contact</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" role="contentinfo">
      <div>
        <strong>{site.legalName}</strong>
        <p>{site.footerTagline}</p>
      </div>
      <div>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <small>&copy; {year} {site.legalName}</small>
      </div>
    </footer>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--navy:#10253f;--blue:#1d5d87;--sky:#e9f4f8;--orange:#ef8b3a;--ink:#203044;--muted:#5b6b7b;--line:#d4e1e7;font-family:'DM Sans',sans-serif;color:var(--ink);background:#fbfcfc}*{box-sizing:border-box}body{margin:0;line-height:1.6}img{display:block;max-width:100%;height:auto}a{color:var(--blue)}a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:1rem;top:1rem;background:white;padding:.5rem;z-index:5}.site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem max(1.5rem,calc((100% - 1120px)/2));background:white;border-bottom:1px solid var(--line)}.brand{color:var(--navy);text-decoration:none;display:flex;align-items:center}.brand img{display:block;width:auto;height:56px}nav{display:flex;gap:1.25rem;flex-wrap:wrap}nav a{font-weight:500;text-decoration:none}main{max-width:1120px;margin:auto;padding:0 1.5rem}.site-footer{margin-top:6rem;padding:2.5rem max(1.5rem,calc((100% - 1120px)/2));display:flex;justify-content:space-between;gap:2rem;background:var(--navy);color:#fff}.site-footer a{color:#fff;margin-right:1.5rem}.site-footer small,.site-footer p{display:block;color:#c4d3dd;margin:.4rem 0}.hero{padding:7rem 0 5rem;max-width:800px}.eyebrow{color:var(--blue);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.8rem}.hero h1{font:700 clamp(2.5rem,7vw,5.5rem)/1.04 'Space Grotesk',sans-serif;color:var(--navy);margin:1rem 0 1.5rem;letter-spacing:-.04em}.hero p{font-size:1.2rem;max-width:650px;color:var(--muted)}.button{display:inline-block;background:var(--orange);color:var(--navy);font-weight:700;padding:.8rem 1.15rem;margin-top:1rem;text-decoration:none;border-radius:3px}.section{padding:3rem 0}.section h2,.page-heading h1{font:700 clamp(2rem,5vw,3.5rem)/1.1 'Space Grotesk',sans-serif;color:var(--navy)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{padding:1.5rem;background:var(--sky);border-top:4px solid var(--orange)}.card img{width:100%;aspect-ratio:16/9;object-fit:cover}.prose img{width:100%;max-height:32rem;object-fit:contain;object-position:center}.card h3{font-family:'Space Grotesk',sans-serif;color:var(--navy);line-height:1.2}.page-heading{padding:5rem 0 2rem}.prose{max-width:720px}.prose h2{color:var(--navy)}label{display:block;font-weight:700;margin-top:1rem}input,textarea,select{display:block;width:100%;max-width:650px;padding:.75rem;border:1px solid #8aa3b2;border-radius:3px;font:inherit;margin-top:.35rem}textarea{min-height:150px}.check{display:flex;gap:.5rem;align-items:start;font-weight:400}.check input{width:auto;margin-top:.4rem}.field-error{display:block;color:#a32626;font-size:.9rem;font-weight:500}.form-status{max-width:650px;margin:1rem 0;padding:1rem;border-left:4px solid var(--blue);background:var(--sky)}.form-status.failure{border-color:#a32626}.form-status.success{border-color:#28734a}.form-status a{font-weight:700}.form-status:focus{outline:3px solid var(--orange);outline-offset:3px}.empty{padding:2rem;background:var(--sky);border-left:4px solid var(--orange)}@media(max-width:700px){.site-header{align-items:flex-start;flex-direction:column}.hero{padding:4rem 0}.cards{grid-template-columns:1fr}.site-footer{flex-direction:column;margin-top:4rem}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}
</style>
