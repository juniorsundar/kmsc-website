# Production static serving configuration.
# Caddy obtains certificates for both hostnames automatically. The website
# reads the atomic live symlink; it never writes to the release tree.
kautilyamsc.com {
    root * /srv/kmsc-website/live
    encode gzip
    # Formspree's domain restriction checks Referer; retain the origin on
    # cross-origin form POSTs without exposing the full page URL.
    header Referrer-Policy "strict-origin-when-cross-origin"
    file_server
}

www.kautilyamsc.com {
    redir https://kautilyamsc.com{uri} permanent
}
